{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"build:ui": "bun run --cwd ../web build && rm -rf ./public && cp -r ../web/dist ./public",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"test": "bun test ./src/__tests__",
		"test:watch": "bun test --watch ./src/__tests__"
	},
	"dependencies": {
		"@licences-app/api": "workspace:*",
		"@licences-app/auth": "workspace:*",
		"@licences-app/db": "workspace:*",
		"@licences-app/env": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@licences-app/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.16.5",
		"typescript": "catalog:"
	}
}
